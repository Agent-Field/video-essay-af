# ===== Required =====
# OpenRouter powers reasoning (.ai), narration (Gemini TTS via /audio/speech) and
# the AForge finishing-editor harness. One key, everything. https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-...

# Reasoning model for every .ai() call (override per request with {"input": {"model": "..."}}).
AI_MODEL=openrouter/deepseek/deepseek-v4-flash
# Stronger/slower alternatives:
# AI_MODEL=openrouter/deepseek/deepseek-v4-pro-0813
# AI_MODEL=openrouter/google/gemini-3.7-flash
# AI_MODEL=openrouter/anthropic/claude-sonnet-5

# ===== Optional — better stock footage / web search (all have free tiers) =====
# Without these, footage comes from Wikimedia Commons and text cards; search uses
# DuckDuckGo + Wikipedia.
# PEXELS_API_KEY=          # https://www.pexels.com/api/   (best free footage)
# PIXABAY_API_KEY=         # https://pixabay.com/api/docs/
# TAVILY_API_KEY=          # https://tavily.com  (or BRAVE_API_KEY / SERPER_API_KEY)

# ===== Optional — narration & harness =====
# AFORGE_BIN pins the AForge harness for host runs (the Docker image already sets it).
# Unset, agentfield >=0.1.143 runs CodeAF for `aforge` requests. This product stays
# on AForge on purpose until its own CodeAF migration; point this at your aforge binary.
# AFORGE_BIN=/absolute/path/to/aforge
# VEA_TTS_MODEL=google/gemini-3.1-flash-tts-preview
# VEA_TTS_SPEED=1.12             # atempo on the narration (1.0 = natural Gemini pace)
# VEA_HARNESS_MODEL=             # model the AForge editor uses (default: AForge's own)
# VEA_USE_HARNESS=true           # false → skip AForge, always use the python ffmpeg cut
# VEA_EDIT_ROUNDS=2              # max editorial rounds
# VEA_VERIFY_CLAIMS=6            # adversarially fact-checked claims per run
# AGENTFIELD_HARNESS_TIMEOUT_SECONDS=1500

# ===== Ports / ids =====
AGENT_NODE_ID=video-essay-af
AGENT_NODE_PORT=8001
AGENTFIELD_HTTP_PORT=8080
